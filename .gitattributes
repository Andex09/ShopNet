# Normalize line endings in the repository; check out with the platform default.
* text=auto

*.cs      text diff=csharp
*.razor   text
*.csproj  text
*.slnx    text
*.json    text
*.md      text
*.sh      text eol=lf
*.tf      text

*.png     binary
*.ico     binary
*.woff    binary
*.ttf     binary
*.eot     binary
*.otf     binary
