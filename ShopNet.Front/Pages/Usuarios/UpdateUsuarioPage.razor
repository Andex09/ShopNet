@page "/usuario/update/{IdUsuario}"

<PageTitle>Actualizar usuario</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <UpdateUsuarioComponent IdUsuario="@IdUsuario" />
    </Authorized>
    <NotAuthorized>
        No autorizado
    </NotAuthorized>
</AuthorizeView>


@code {
    [Parameter]
    public string IdUsuario { get; set; }


    protected override async Task OnInitializedAsync()
    {
        IdUsuario = IdUsuario;
    }
}