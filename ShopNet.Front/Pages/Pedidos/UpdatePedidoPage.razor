@page "/pedido/update/{IdPedido}"

<AuthorizeView Roles="Admin">
    <Authorized>
        <UpdatePedidoComponent IdPedido="@IdPedido" />
    </Authorized>
    <NotAuthorized>
        No tiene permisos suficientes
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string IdPedido { get; set; }


    protected override async Task OnInitializedAsync()
    {
        IdPedido = IdPedido;
    }
}