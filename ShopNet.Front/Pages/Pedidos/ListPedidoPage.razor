@page "/pedido/list"

<h1>Pedidos</h1>

<AuthorizeView Roles="Admin">
    <Authorized>
        <ListPedidoComponent />

        <div class="fab-container">
            <a href="pedido/create" style="text-decoration: none">
                <div class="fab fab-icon-holder">
                    <span class="oi oi-plus rounded-circle shadow-sm" />
                </div>
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        No tiene permisos suficientes
    </NotAuthorized>
</AuthorizeView>