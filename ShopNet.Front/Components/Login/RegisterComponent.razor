@using ShopNet.Front.Auth
@using ShopNet.Front.Models
@using Models;

@inject HttpClient httpClient
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navManager

<div class="div-container-form">

    <AlertMessageComponent Message="@message" MessageType="@messageType" />
    <EditForm Model="oUsuario" OnValidSubmit="@Login" class="col-md-6 container-form">
        <DataAnnotationsValidator />

        <h3>Registarse</h3>

        <div class="form-group">
            <label>Usuario</label>
            <InputText @bind-Value="oUsuario.UsuNombre" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Contraseña</label>
            <InputText type="password" @bind-Value="oUsuario.UsuPass" class="form-control" required />
        </div>

        <input type="submit" value="Crear usuario" class="btn btn-primary btn-sm m-4" />
    </EditForm>
    @if (isBusy)
    {
        <div class="busy"></div>
    }
</div>

@code {
    UsuarioLoginRegisterDto oUsuario = new UsuarioLoginRegisterDto();

    bool isBusy = false;
    string message = string.Empty;
    AlertMessageType messageType = AlertMessageType.Success;


    private async Task Login()
    {
        isBusy = true;

        var response = await httpClient.PostAsJsonAsync<UsuarioLoginRegisterDto>("/api/Auth/register", oUsuario);

        if (response.IsSuccessStatusCode)
        {
            messageType = AlertMessageType.Success;
            message = "Usuario creado";
            isBusy = false;
            return; 

        }
        else
        {
            messageType = AlertMessageType.Error;
            message = "No se pudo crear el usuario";
            isBusy = false;
            return; 
        }

    }


}
