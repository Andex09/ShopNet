@using ShopNet.Front.Models
@using Models;
@using ShopNet.Front.Services.Contracts


<div class="div-container-form">
    <EditForm Model="oPedido" OnSubmit="Update" class="container-form col-md-10">
        <div class="form-group">

            <div class="form-group">
                <label>Usuario</label>
                <InputSelect @bind-Value="oPedido.PedUsu" class="form-select">
                    @foreach (var usuario in usuarios)
                    {
                        <option value="@usuario.UsuID">@usuario.UsuNombre</option>
                    }
                </InputSelect>
            </div>
            <div class="form-group">
                <label>Producto</label>
                <select @onchange="SetProducto"
                        class="form-select">
                    @foreach (var producto in productos)
                    {
                        <option value="@producto.ProdID">@producto.ProDesc</option>
                    }
                </select>
            </div>
            <div>
                <label>Cantidad</label>
                <input type="number" value="@oPedido.PedCant" @onchange="SetCantidad" class="form-control" />
            </div>
            <div>
                <label>Valor unitario</label>
                <InputNumber @bind-Value="productoSelected.ProValor" class="form-control" readonly />
            </div>
            <div>
                <label>Sub total</label>
                <InputNumber @bind-Value="oPedido.PedSubTot" class="form-control" readonly />
            </div>
            <div>
                <label>IVA</label>
                <InputNumber @bind-Value="oPedido.PedIVA" class="form-control" readonly />
            </div>
            <div>
                <label>Total</label>
                <InputNumber @bind-Value="oPedido.PedTotal" class="form-control" readonly />
            </div>

        </div>
        <div class="d-inline-block">
            <input type="submit" value="Actualizar" class="btn btn-primary btn-sm" />
            <input type="button" value="Eliminar" @onclick="Delete" class="btn btn-primary btn-sm" />
            <input type="button" value="Cerrar" @onclick="Close" class="btn btn-primary btn-sm" />
        </div>
    </EditForm>

    @if (isBusy)
    {
        <div class="busy"></div>
    }
</div>

@inject HttpClient httpClient
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navManager
@inject IProductoService productoService
@inject IPedidoService pedidoService
@inject IUsuarioService usuarioService

@code {
    [Parameter]
    public string IdPedido { get; set; }

    PedidoDto oPedido = new PedidoDto();
    List<ProductoDto> productos = new List<ProductoDto>();
    List<UsuarioListDto> usuarios = new List<UsuarioListDto>();
    ProductoDto productoSelected = new ProductoDto();


    bool isBusy = false;
    string message = string.Empty;
    AlertMessageType messageType = AlertMessageType.Success;

    protected async override Task OnInitializedAsync()
    {
        isBusy = true;

        productos = await productoService.GetItems();
        usuarios = await usuarioService.GetItems();
        oPedido = await pedidoService.GetItem(Int16.Parse(IdPedido));
        productoSelected = productos.Where(p => p.ProdID == oPedido.PedPro).FirstOrDefault();
        isBusy = false;
    }

    private async void Update()
    {
        isBusy = true;

        var response = await httpClient.PutAsJsonAsync<PedidoDto>($"/api/Pedido/{IdPedido}", oPedido);

        if (response.IsSuccessStatusCode)
        {
            navManager.NavigateTo("/Pedido/list", true);
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            messageType = AlertMessageType.Error;
            message = "No se pudo actualizar el pedido";
            isBusy = false;
            return;
        }

        isBusy = false;
    }

    private async void Delete(){
        var response = await httpClient.DeleteAsync($"/api/Pedido/{IdPedido}");

        if (response.IsSuccessStatusCode)
        {
            navManager.NavigateTo("/pedido/list", true);
        }
        else
        {
            messageType = AlertMessageType.Error;
            message = "No se pudo eliminar el producto";
        }
    }

    private void Close()
    {
        navManager.NavigateTo("Pedido/list");
    }

    void SetProducto(ChangeEventArgs e)
    {
        if (e.Value is not null)
        {
            productoSelected = productos.Where(p => p.ProdID == Convert.ToInt16(e.Value)).FirstOrDefault();
            oPedido.PedPro = productoSelected.ProdID;
            oPedido.PedVrUnit = productoSelected.ProValor;
            Calcular();
        }
    }

    void SetCantidad(ChangeEventArgs e)
    {
        if (e.Value is not null)
        {
            oPedido.PedCant = Convert.ToInt16(e.Value);
            Calcular();
        }
    }

    private void Calcular()
    {
        decimal subTotal = Convert.ToDecimal(oPedido.PedCant) * oPedido.PedVrUnit;
        decimal ivaPorcentaje = 0.19m;
        decimal iva = subTotal * ivaPorcentaje;
        decimal total = subTotal + iva;

        oPedido.PedIVA = Convert.ToDouble(iva);
        oPedido.PedSubTot = subTotal;
        oPedido.PedTotal = total;
    }
}
