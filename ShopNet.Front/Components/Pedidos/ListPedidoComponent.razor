@using ShopNet.Front.Models
@using ShopNet.Front.Services.Contracts
@using ShopNet.Models.Dtos

@inject NavigationManager navManager
@inject IPedidoService pedidoService

@if (pedidos.Count == 0 && !isBusy)
{
    <h3>No hay pedidos</h3>
}
else if (!isBusy)
{
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Producto</th>
                <th>Valor total</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in pedidos)
            {
                <tr>
                    <td>@pedido.PedUsu</td>
                    <td>@pedido.PedPro</td>
                    <td>@pedido.PedTotal</td>
                    <td class="generic-icon"><a href="pedido/update/@pedido.PedID"><span class="oi oi-pencil" /></a></td>
                    <td class="generic-icon"><a href="pedido/@pedido.PedID"><span class="oi oi-eye" /></a></td>
                </tr>
            }
        </tbody>
    </table>
}
@if (isBusy)
{
    <div class="align-self-center busy"></div>
}

@code {

    List<PedidoDto> pedidos = new List<PedidoDto>();

    bool isBusy = false;
    string message = string.Empty;
    AlertMessageType messageType = AlertMessageType.Success;

    protected async override Task OnInitializedAsync()
    {
        isBusy = true;
        pedidos = await pedidoService.GetItems();
        isBusy = false;
    }

}
