@using ShopNet.Front.Models
@using Models;
@using ShopNet.Front.Services.Contracts

<div class="div-container-form">
    @if (oProducto != null)
    {
        <EditForm Model="oProducto" class="container-form col-md-10">
            <div class="form-group">
                <div>
                    <label>Descripción</label>
                    <InputText @bind-Value="oProducto.ProDesc" class="form-control" />
                </div>
                <div>
                    <label>Valor</label>
                    <InputNumber @bind-Value="oProducto.ProValor" class="form-control" />
                </div>

            </div>
            <div class="d-inline-block">
                <input type="button" value="Actualizar" @onclick="Update" class="btn btn-primary btn-sm" />
                <input type="button" value="Eliminar" @onclick="Delete" class="btn btn-primary btn-sm" />
                <input type="button" value="Cerrar" @onclick="Close" class="btn btn-primary btn-sm" />
            </div>
        </EditForm>
    }
    @if (isBusy)
    {
        <div class="align-self-center busy"></div>
    }
</div>


@inject HttpClient httpClient
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navManager
@inject IProductoService productoService

@code {
    [Parameter]
    public string IdProducto { get; set; }

    ProductoDto oProducto = new ProductoDto();

    bool isBusy = false;
    string message = string.Empty;
    AlertMessageType messageType = AlertMessageType.Success;

    protected async override Task OnInitializedAsync()
    {
        isBusy = true;
        oProducto = await productoService.GetItem(Int16.Parse(IdProducto));
        isBusy = false;
    }

    private async void Update()
    {
        
        var response = await httpClient.PutAsJsonAsync<ProductoDto>($"/api/Producto/{IdProducto}", oProducto);

        if (response.IsSuccessStatusCode)
        {
            navManager.NavigateTo("/producto/list", true);
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            messageType = AlertMessageType.Error;
            message = "No se pudo actualizar el producto";
        }

        navManager.NavigateTo("producto/list");
    }

    private async void Delete(){
        
        var response = await httpClient.DeleteAsync($"/api/Producto/{IdProducto}");

        if (response.IsSuccessStatusCode)
        {
            navManager.NavigateTo("/producto/list", true);
        }
        else
        {
            messageType = AlertMessageType.Error;
            message = "No se pudo eliminar el producto";
        }
    }

    private void Close()
    {
        navManager.NavigateTo("producto/list");
    }
}
