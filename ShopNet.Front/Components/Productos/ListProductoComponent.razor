@using ShopNet.Front.Models
@using ShopNet.Front.Services.Contracts
@using ShopNet.Models.Dtos

@inject NavigationManager navManager
@inject IProductoService productoService

@if(productos.Count == 0 && !isBusy){
    <h3>No hay productos</h3>
}
else if(!isBusy) {
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descripción</th>
                <th>Valor</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in productos)
            {
                <tr>
                    <td>@producto.ProdID</td>
                    <td>@producto.ProDesc</td>
                    <td>@producto.ProValor</td>
                    <AuthorizeView Roles="Admin">
                        <td class="generic-icon"><a href="producto/update/@producto.ProdID"><span class="oi oi-pencil" /></a></td>
                    </AuthorizeView>
                    <td class="generic-icon"><a href="producto/@producto.ProdID"><span class="oi oi-eye" /></a></td>
                </tr>
            }
    </tbody>
    </table>
}
@if (isBusy)
{
    <div class="align-self-center busy"></div>
}

@code {

    List<ProductoDto> productos = new List<ProductoDto>();

    bool isBusy = false;
    string message = string.Empty;
    AlertMessageType messageType = AlertMessageType.Success;

    protected async override Task OnInitializedAsync()
    {
        isBusy = true;
        productos = await productoService.GetItems();
        isBusy = false;
    }

}
