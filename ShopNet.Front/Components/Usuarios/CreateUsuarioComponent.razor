@using ShopNet.Front.Models
@using Models;
@using ShopNet.Front.Services.Contracts


<div class="div-container-form">
    <AlertMessageComponent Message="@message" MessageType="@messageType" />
    <EditForm Model="oUsuario" OnValidSubmit="@Create" class="col-md-8 container-form">
        <DataAnnotationsValidator />
        <h3>Crear usuario</h3>
        <div class="form-group">
            <div>
                <label>Nombre</label>
                <InputText @bind-Value="oUsuario.UsuNombre" class="form-control" />
            </div>
            <div>
                <label>Valor</label>
                <InputText type="password" @bind-Value="oUsuario.UsuPass" class="form-control" />
            </div>
            <div>
                <InputCheckbox @bind-Value="admin" class="form-check-inline"/>
                <label class="form-check-label">¿Usuario administrador?</label>
            </div>
        </div>
        <div class="d-inline-block">
            <input type="submit" value="Crear" class="btn btn-primary btn-sm" />
        <input type="button" value="Cerrar" @onclick="Close" class="btn btn-primary btn-sm" />
        </div>
    </EditForm>
    @if (isBusy)
    {
        <div class="busy"></div>
    }
</div>



@inject HttpClient httpClient
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navManager
@inject IUsuarioService usuerioSerivce

@code {

    UsuarioCreateDto oUsuario = new UsuarioCreateDto();

    bool admin = false;

    bool isBusy = false;
    string message = string.Empty;
    AlertMessageType messageType = AlertMessageType.Success;

    protected async override Task OnInitializedAsync()
    {
    }

    private async void Create()
    {
        isBusy = true;

        try
        {
            oUsuario.UsuRol = admin ? "Admin" : "Basic";

            var response = await httpClient.PostAsJsonAsync<UsuarioCreateDto>("/api/Usuario", oUsuario);

            if (response.IsSuccessStatusCode)
            {
                navManager.NavigateTo("/Usuario/list", true);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                messageType = AlertMessageType.Error;
                message = "No se pudo crear el usuario";
            }
        }
        catch (Exception)
        {
            messageType = AlertMessageType.Error;
            message = "No se pudo crear el usuario";
        }

        isBusy = false;
    }

    private void Close()
    {
        navManager.NavigateTo("Usuario/list");
    }
}
