@inject AuthService Auth
@inject SessionAuthStateProvider AuthState
@inject NavigationManager Navigation

<div class="div-container-form">
    <AlertMessage Message="@message" MessageType="@messageType" />

    <EditForm Model="request" OnValidSubmit="LoginAsync" class="col-md-6 container-form">
        <DataAnnotationsValidator />

        <h3>Iniciar sesión</h3>

        <div class="mb-3">
            <label class="form-label">Usuario</label>
            <InputText @bind-Value="request.UserName" class="form-control" autocomplete="username" />
            <ValidationMessage For="() => request.UserName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <InputText type="password" @bind-Value="request.Password" class="form-control" autocomplete="current-password" />
            <ValidationMessage For="() => request.Password" />
        </div>

        <button type="submit" class="btn btn-primary btn-sm" disabled="@isBusy">Iniciar sesión</button>
    </EditForm>

    @if (isBusy)
    {
        <Busy />
    }
</div>

@code {
    private readonly LoginRequest request = new();
    private bool isBusy;
    private string? message;
    private AlertMessageType messageType = AlertMessageType.Error;

    protected override void OnInitialized()
    {
        if (AuthState.SessionExpired)
        {
            (messageType, message) = (AlertMessageType.Warning, "Tu sesión expiró. Inicia sesión de nuevo.");
        }
    }

    private async Task LoginAsync()
    {
        isBusy = true;
        message = null;

        var result = await Auth.LoginAsync(request);
        if (result is { IsSuccess: true, Value: not null })
        {
            await AuthState.SignInAsync(result.Value.Token);
            Navigation.NavigateTo("producto/list");
            return;
        }

        messageType = AlertMessageType.Error;
        message = result.StatusCode switch
        {
            HttpStatusCode.Unauthorized => "Usuario o contraseña incorrectos.",
            HttpStatusCode.TooManyRequests => "Demasiados intentos. Espera un minuto e intenta de nuevo.",
            _ => "No se pudo iniciar sesión. Intenta de nuevo.",
        };
        isBusy = false;
    }
}
