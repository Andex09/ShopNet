@inject ProductService Products
@inject CategoryService Categories
@inject NavigationManager Navigation

<div class="div-container-form">
    <AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

    @if (isLoading)
    {
        <Busy />
    }
    else
    {
        <EditForm Model="request" OnValidSubmit="SaveAsync" class="col-md-8 container-form">
            <DataAnnotationsValidator />

            <h3>@(IsEdit ? "Editar producto" : "Crear producto")</h3>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <InputText @bind-Value="request.Name" class="form-control" />
                <ValidationMessage For="() => request.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <InputTextArea @bind-Value="request.Description" class="form-control" rows="4" />
                <ValidationMessage For="() => request.Description" />
            </div>
            <div class="mb-3">
                <label class="form-label">Categoría</label>
                <InputSelect @bind-Value="request.CategoryId" class="form-select">
                    <option value="0">Selecciona una categoría</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => request.CategoryId" />
            </div>
            <div class="mb-3">
                <label class="form-label">Precio</label>
                <InputNumber @bind-Value="request.Price" class="form-control" />
                <ValidationMessage For="() => request.Price" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="request.IsActive" class="form-check-input" id="is-active" />
                <label class="form-check-label" for="is-active">Activo (visible en el catálogo)</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm" disabled="@isBusy">@(IsEdit ? "Actualizar" : "Crear")</button>
                @if (IsEdit)
                {
                    <button type="button" class="btn btn-danger btn-sm" disabled="@isBusy" @onclick="DeleteAsync">Eliminar</button>
                    <small class="text-body-secondary align-self-center">Si tiene pedidos, se desactiva en vez de eliminarse.</small>
                }
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Cerrar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private readonly ProductRequest request = new();
    private List<CategoryResponse> categories = [];
    private bool isLoading;
    private bool isBusy;
    private string? message;

    /// <summary>Product to edit. When null, the form creates a new product.</summary>
    [Parameter]
    public int? ProductId { get; set; }

    private bool IsEdit => ProductId is not null;

    protected override async Task OnParametersSetAsync()
    {
        categories = (await Categories.GetAllAsync()).Value ?? [];

        if (ProductId is not { } id)
        {
            return;
        }

        isLoading = true;
        var result = await Products.GetAsync(id);
        if (result.Value is { } product)
        {
            request.Name = product.Name;
            request.Description = product.Description;
            request.Price = product.Price;
            request.CategoryId = product.CategoryId;
            request.IsActive = product.IsActive;
        }
        else
        {
            message = "No se pudo consultar el producto.";
        }

        isLoading = false;
    }

    private async Task SaveAsync()
    {
        isBusy = true;
        var success = ProductId is { } id
            ? (await Products.UpdateAsync(id, request)).IsSuccess
            : (await Products.CreateAsync(request)).IsSuccess;

        if (success)
        {
            Close();
            return;
        }

        message = IsEdit ? "No se pudo actualizar el producto." : "No se pudo crear el producto.";
        isBusy = false;
    }

    private async Task DeleteAsync()
    {
        isBusy = true;
        var result = await Products.DeleteAsync(ProductId!.Value);
        if (result.IsSuccess)
        {
            Close();
            return;
        }

        message = "No se pudo eliminar el producto.";
        isBusy = false;
    }

    private void Close() => Navigation.NavigateTo("producto/list");
}
