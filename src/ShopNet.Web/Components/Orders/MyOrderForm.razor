@inject OrderService Orders
@inject ProductService Products
@inject NavigationManager Navigation

@* Customer: order products for themselves. The API takes the user from the token. *@
<div class="div-container-form">
    <AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

    @if (isLoading)
    {
        <Busy />
    }
    else
    {
        <div class="col-md-10 container-form">
            <h3>Nuevo pedido</h3>

            <OrderLinesEditor Lines="request.Lines" Products="products" />

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm" disabled="@isBusy" @onclick="CreateAsync">Crear pedido</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo("producto/list"))">Cerrar</button>
            </div>
        </div>
    }
</div>

@code {
    private readonly CreateMyOrderRequest request = new() { Lines = [new OrderLineRequest()] };
    private List<ProductResponse> products = [];
    private bool isLoading = true;
    private bool isBusy;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        products = (await Products.GetAllAsync()).Value ?? [];
        isLoading = false;
    }

    private async Task CreateAsync()
    {
        if (!OrderLinesEditor.AreComplete(request.Lines))
        {
            message = "Elige un producto y una cantidad entre 1 y 1.000 en cada línea.";
            return;
        }

        isBusy = true;
        var result = await Orders.CreateMineAsync(request);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("pedido/mis-pedidos");
            return;
        }

        message = result.StatusCode switch
        {
            HttpStatusCode.NotFound => "Uno de los productos ya no existe.",
            HttpStatusCode.BadRequest => "Uno de los productos ya no está disponible.",
            _ => "No se pudo crear el pedido.",
        };
        isBusy = false;
    }
}
