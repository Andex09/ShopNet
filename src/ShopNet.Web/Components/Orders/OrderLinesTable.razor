@* The lines and totals of a placed order, as the server calculated them. *@
<table class="table table-sm">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-end">Valor unitario</th>
            <th class="text-end">Cantidad</th>
            <th class="text-end">Valor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Order.Lines)
        {
            <tr>
                <td>@line.ProductName</td>
                <td class="text-end">@line.UnitPrice.ToString("C0")</td>
                <td class="text-end">@line.Quantity</td>
                <td class="text-end">@line.LineTotal.ToString("C0")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><th colspan="3" class="text-end">Subtotal</th><td class="text-end">@Order.Subtotal.ToString("C0")</td></tr>
        <tr><th colspan="3" class="text-end">IVA (@Order.TaxRate.ToString("P0"))</th><td class="text-end">@Order.Tax.ToString("C0")</td></tr>
        <tr><th colspan="3" class="text-end">Total</th><td class="text-end"><strong>@Order.Total.ToString("C0")</strong></td></tr>
    </tfoot>
</table>

@code {
    [Parameter, EditorRequired]
    public OrderResponse Order { get; set; } = null!;
}
