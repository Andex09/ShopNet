@inject OrderService Orders
@inject UserService Users

<AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

@if (isBusy)
{
    <Busy />
}
else if (orders.Count == 0)
{
    <h3>No hay pedidos</h3>
}
else
{
    <OrderTable Orders="orders" UserNames="userNames" ShowUser ShowActions />
}

@code {
    private List<OrderResponse> orders = [];
    private Dictionary<int, string> userNames = [];
    private bool isBusy = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var ordersTask = Orders.GetAllAsync();
        var usersTask = Users.GetAllAsync();
        await Task.WhenAll(ordersTask, usersTask);

        var result = await ordersTask;
        orders = result.Value ?? [];
        userNames = ((await usersTask).Value ?? []).ToDictionary(u => u.Id, u => u.UserName);
        message = result.IsSuccess ? null : "No se pudieron cargar los pedidos.";
        isBusy = false;
    }
}
