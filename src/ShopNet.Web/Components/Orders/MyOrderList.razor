@inject OrderService Orders
@inject ProductService Products

<AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

@if (isBusy)
{
    <Busy />
}
else if (orders.Count == 0)
{
    <h3>Aún no tienes pedidos</h3>
}
else
{
    <OrderTable Orders="orders" ProductNames="productNames" />
}

@code {
    private List<OrderResponse> orders = [];
    private Dictionary<int, string> productNames = [];
    private bool isBusy = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var ordersTask = Orders.GetMineAsync();
        var productsTask = Products.GetAllAsync();
        await Task.WhenAll(ordersTask, productsTask);

        var result = await ordersTask;
        orders = result.Value ?? [];
        productNames = ((await productsTask).Value ?? []).ToDictionary(p => p.Id, p => p.Name);
        message = result.IsSuccess ? null : "No se pudieron cargar tus pedidos.";
        isBusy = false;
    }
}
