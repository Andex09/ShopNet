@* Live estimate while the user picks a product and quantity. The API calculates the real amounts. *@
@if (Product is not null && Quantity > 0)
{
    var (subtotal, tax, total) = OrderEstimate.Calculate(Product.Price, Quantity);
    <table class="table table-sm w-auto">
        <tbody>
            <tr><th>Valor unitario</th><td class="text-end">@Product.Price.ToString("C0")</td></tr>
            <tr><th>Subtotal</th><td class="text-end">@subtotal.ToString("C0")</td></tr>
            <tr><th>IVA (@OrderEstimate.TaxRate.ToString("P0"))</th><td class="text-end">@tax.ToString("C0")</td></tr>
            <tr><th>Total estimado</th><td class="text-end"><strong>@total.ToString("C0")</strong></td></tr>
        </tbody>
    </table>
}

@code {
    [Parameter]
    public ProductResponse? Product { get; set; }

    [Parameter]
    public int Quantity { get; set; }
}
