@inject OrderService Orders
@inject ProductService Products
@inject UserService Users
@inject NavigationManager Navigation

@* Admin: create an order for any user, or change the lines of a pending order and confirm or cancel it. *@
<div class="div-container-form">
    <AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

    @if (isLoading)
    {
        <Busy />
    }
    else
    {
        <div class="col-md-10 container-form">
            <h3>
                @(IsEdit ? $"Pedido #{OrderId}" : "Crear pedido")
                @if (status is not null)
                {
                    <OrderStatusBadge Status="@status" />
                }
            </h3>

            @if (!IsEdit)
            {
                <div class="mb-3">
                    <label class="form-label" for="order-user">Usuario</label>
                    <select id="order-user" class="form-select" @bind="userId">
                        <option value="0">Seleccione un usuario</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.UserName</option>
                        }
                    </select>
                </div>
            }

            @if (IsPending)
            {
                <OrderLinesEditor Lines="lines" Products="products" />
            }
            else
            {
                <p>Este pedido ya no se puede modificar.</p>
            }

            <div class="d-flex gap-2">
                @if (IsPending)
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@isBusy" @onclick="SaveAsync">@(IsEdit ? "Guardar líneas" : "Crear")</button>
                }
                @if (IsEdit && IsPending)
                {
                    <button type="button" class="btn btn-success btn-sm" disabled="@isBusy" @onclick="ConfirmAsync">Confirmar pedido</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@isBusy" @onclick="CancelAsync">Cancelar pedido</button>
                }
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Cerrar</button>
            </div>
        </div>
    }
</div>

@code {
    private List<OrderLineRequest> lines = [new OrderLineRequest()];
    private List<ProductResponse> products = [];
    private List<UserResponse> users = [];
    private int userId;
    private string? status;
    private bool isLoading = true;
    private bool isBusy;
    private string? message;

    /// <summary>Order to edit. When null, the form creates a new order.</summary>
    [Parameter]
    public int? OrderId { get; set; }

    private bool IsEdit => OrderId is not null;

    private bool IsPending => status is null or OrderStatusNames.Pending;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        products = (await Products.GetAllAsync()).Value ?? [];

        if (OrderId is { } id)
        {
            var result = await Orders.GetAsync(id);
            if (result.Value is { } order)
            {
                status = order.Status;
                lines = [.. order.Lines.Select(l => new OrderLineRequest { ProductId = l.ProductId, Quantity = l.Quantity })];
            }
            else
            {
                message = "No se pudo consultar el pedido.";
            }
        }
        else
        {
            users = (await Users.GetAllAsync()).Value ?? [];
        }

        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (!IsEdit && userId <= 0)
        {
            message = "Elige el usuario del pedido.";
            return;
        }

        if (!OrderLinesEditor.AreComplete(lines))
        {
            message = "Elige un producto y una cantidad entre 1 y 1.000 en cada línea.";
            return;
        }

        isBusy = true;
        var statusCode = OrderId is { } id
            ? (await Orders.UpdateAsync(id, new UpdateOrderRequest { Lines = lines })).StatusCode
            : (await Orders.CreateAsync(new CreateOrderRequest { UserId = userId, Lines = lines })).StatusCode;

        if ((int)statusCode is >= 200 and <= 299)
        {
            Close();
            return;
        }

        message = ErrorMessage(statusCode, "No se pudo guardar el pedido.");
        isBusy = false;
    }

    private Task ConfirmAsync() => RunActionAsync(() => Orders.ConfirmAsync(OrderId!.Value), "No se pudo confirmar el pedido.");

    private Task CancelAsync() => RunActionAsync(() => Orders.CancelAsync(OrderId!.Value), "No se pudo cancelar el pedido.");

    private async Task RunActionAsync(Func<Task<ApiResult>> action, string failure)
    {
        isBusy = true;
        var result = await action();
        if (result.IsSuccess)
        {
            Close();
            return;
        }

        message = ErrorMessage(result.StatusCode, failure);
        isBusy = false;
    }

    private static string ErrorMessage(HttpStatusCode statusCode, string fallback) => statusCode switch
    {
        HttpStatusCode.NotFound => "El usuario o alguno de los productos ya no existe.",
        HttpStatusCode.BadRequest => "Revisa el pedido: algún producto ya no está disponible.",
        HttpStatusCode.Conflict => "El pedido ya fue confirmado o cancelado.",
        _ => fallback,
    };

    private void Close() => Navigation.NavigateTo("pedido/list");
}
