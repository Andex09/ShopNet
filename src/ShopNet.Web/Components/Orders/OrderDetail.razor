@inject OrderService Orders
@inject NavigationManager Navigation

<div class="container-fluid" style="max-width: 40rem">
    <h3>Detalle del pedido</h3>

    <AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

    @if (order is null)
    {
        @if (message is null)
        {
            <Busy />
        }
    }
    else
    {
        <table class="table table-borderless">
            <tbody>
                <tr><th>ID</th><td>@order.Id</td></tr>
                <tr><th>Usuario</th><td>#@order.UserId</td></tr>
                <tr><th>Producto</th><td>#@order.ProductId</td></tr>
                <tr><th>Valor unitario</th><td>@order.UnitPrice.ToString("C0")</td></tr>
                <tr><th>Cantidad</th><td>@order.Quantity</td></tr>
                <tr><th>Subtotal</th><td>@order.Subtotal.ToString("C0")</td></tr>
                <tr><th>IVA (@order.TaxRate.ToString("P0"))</th><td>@order.Tax.ToString("C0")</td></tr>
                <tr><th>Total</th><td><strong>@order.Total.ToString("C0")</strong></td></tr>
            </tbody>
        </table>
    }

    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo("pedido/list"))">Cerrar</button>
</div>

@code {
    private OrderResponse? order;
    private string? message;

    [Parameter, EditorRequired]
    public int OrderId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Orders.GetAsync(OrderId);
        order = result.Value;
        message = result.StatusCode switch
        {
            _ when result.IsSuccess => null,
            HttpStatusCode.NotFound => "El pedido no existe.",
            _ => "No se pudo consultar el pedido.",
        };
    }
}
