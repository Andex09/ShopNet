@inject OrderService Orders
@inject NavigationManager Navigation

<div class="container-fluid" style="max-width: 48rem">
    <h3>
        Pedido @(order is null ? null : $"#{order.Id}")
        @if (order is not null)
        {
            <OrderStatusBadge Status="@order.Status" />
        }
    </h3>

    <AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

    @if (order is null)
    {
        @if (message is null)
        {
            <Busy />
        }
    }
    else
    {
        <p class="text-body-secondary">Usuario #@order.UserId · @order.CreatedAt.ToLocalTime().ToString("g")</p>

        <OrderLinesTable Order="order" />
    }

    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo("pedido/list"))">Cerrar</button>
</div>

@code {
    private OrderResponse? order;
    private string? message;

    [Parameter, EditorRequired]
    public int OrderId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Orders.GetAsync(OrderId);
        order = result.Value;
        message = result.StatusCode switch
        {
            _ when result.IsSuccess => null,
            HttpStatusCode.NotFound => "El pedido no existe.",
            _ => "No se pudo consultar el pedido.",
        };
    }
}
