@inject OrderService Orders
@inject NavigationManager Navigation

<div class="container-fluid" style="max-width: 48rem">
    <h3>
        Pedido @(order is null ? null : $"#{order.Id}")
        @if (order is not null)
        {
            <OrderStatusBadge Status="@order.Status" />
        }
    </h3>

    <AlertMessage Message="@message" MessageType="AlertMessageType.Error" />

    @if (order is null)
    {
        @if (message is null)
        {
            <Busy />
        }
    }
    else
    {
        <p class="text-body-secondary">Usuario #@order.UserId · @order.CreatedAt.ToLocalTime().ToString("g")</p>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Valor unitario</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Valor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in order.Lines)
                {
                    <tr>
                        <td>@line.ProductName</td>
                        <td class="text-end">@line.UnitPrice.ToString("C0")</td>
                        <td class="text-end">@line.Quantity</td>
                        <td class="text-end">@line.LineTotal.ToString("C0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="3" class="text-end">Subtotal</th><td class="text-end">@order.Subtotal.ToString("C0")</td></tr>
                <tr><th colspan="3" class="text-end">IVA (@order.TaxRate.ToString("P0"))</th><td class="text-end">@order.Tax.ToString("C0")</td></tr>
                <tr><th colspan="3" class="text-end">Total</th><td class="text-end"><strong>@order.Total.ToString("C0")</strong></td></tr>
            </tfoot>
        </table>
    }

    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo("pedido/list"))">Cerrar</button>
</div>

@code {
    private OrderResponse? order;
    private string? message;

    [Parameter, EditorRequired]
    public int OrderId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Orders.GetAsync(OrderId);
        order = result.Value;
        message = result.StatusCode switch
        {
            _ when result.IsSuccess => null,
            HttpStatusCode.NotFound => "El pedido no existe.",
            _ => "No se pudo consultar el pedido.",
        };
    }
}
