@* Shared table for the admin order list and "Mis pedidos". *@
<table class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Fecha</th>
            @if (ShowUser)
            {
                <th>Usuario</th>
            }
            <th>Productos</th>
            <th>Estado</th>
            <th class="text-end">Total</th>
            @if (ShowActions)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Orders)
        {
            <tr>
                <td><a href="@DetailHref(order.Id)">@order.Id</a></td>
                <td class="text-nowrap">@order.CreatedAt.ToLocalTime().ToString("g")</td>
                @if (ShowUser)
                {
                    <td>@(UserNames.TryGetValue(order.UserId, out var name) ? name : $"#{order.UserId}")</td>
                }
                <td>@Summary(order)</td>
                <td>
                    <OrderStatusBadge Status="@order.Status" />
                </td>
                <td class="text-end">@order.Total.ToString("C0")</td>
                @if (ShowActions)
                {
                    <td class="text-nowrap">
                        <a href="@DetailHref(order.Id)" title="Ver"><span class="oi oi-eye"></span></a>
                        <a href="pedido/update/@order.Id" title="Editar" class="ms-3"><span class="oi oi-pencil"></span></a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<OrderResponse> Orders { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<int, string> UserNames { get; set; } = new Dictionary<int, string>();

    [Parameter]
    public Func<int, string> DetailHref { get; set; } = id => $"pedido/{id}";

    [Parameter]
    public bool ShowUser { get; set; }

    [Parameter]
    public bool ShowActions { get; set; }

    /// <summary>"Producto" or "Producto y 2 más".</summary>
    private static string Summary(OrderResponse order) => order.Lines switch
    {
        [] => "—",
        [var only] => $"{only.ProductName} × {only.Quantity}",
        [var first, ..] => $"{first.ProductName} y {order.Lines.Count - 1} más",
    };
}
