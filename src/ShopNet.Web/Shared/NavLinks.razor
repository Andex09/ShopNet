<AuthorizeView Roles="@RoleNames.Admin">
    <a href="usuario/list" class="nav-link btn btn-link">Usuarios</a>
    <a href="pedido/list" class="nav-link btn btn-link">Pedidos</a>
</AuthorizeView>

<AuthorizeView Roles="@RoleNames.Customer">
    <a href="pedido/mis-pedidos" class="nav-link btn btn-link">Mis pedidos</a>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <a href="producto/list" class="nav-link btn btn-link">Productos</a>
        <a href="pedido/create" class="nav-link btn btn-link">Crear pedido</a>
        <a href="logout" class="nav-link btn btn-link">Cerrar sesión</a>
    </Authorized>
    <NotAuthorized>
        <a href="login" class="nav-link btn btn-link">Iniciar sesión</a>
        <a href="register" class="nav-link btn btn-link">Registrarse</a>
    </NotAuthorized>
</AuthorizeView>
